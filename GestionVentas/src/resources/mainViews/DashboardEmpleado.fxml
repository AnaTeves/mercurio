<!-- Vista del vendedor al iniciar sesion -->
<StackPane alignment="CENTER" maxHeight="800" maxWidth="1000" prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Controllers.EmpleadoController">
    <BorderPane fx:id="mainBorderPane" StackPane.alignment="CENTER">
        <!-- Contenedor izquierdo -->
        <left>
            <!-- Contenedor vertical que contiene el menu de opciones -->
            <VBox fx:id="menuLateral" alignment="CENTER_LEFT" spacing="40" prefWidth="180" style="-fx-background-color: rgb(90, 108, 128);">
            <padding>
                <Insets left="20" right="20" />
            </padding>
                <Button style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10; -fx-text-fill: White;" text="Vendedor" contentDisplay="LEFT" graphicTextGap="15">
                    <graphic>
                        <ImageView fitHeight="27" fitWidth="27" preserveRatio="true">
                            <image>
                                <Image url="@../files/usuario.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                </Button>
                <Button onAction="#handleReportes" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10; -fx-text-fill: White;" text="Reportes" contentDisplay="LEFT" graphicTextGap="15">
                    <graphic>
                        <ImageView fitHeight="27" fitWidth="27" preserveRatio="true">
                            <image>
                                <Image url="@../files/reportes.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                </Button>
                <Button onAction="#handleVentas" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10; -fx-text-fill: White;" text="Registrar&#10;Venta" contentDisplay="LEFT" graphicTextGap="15">
                    <graphic>
                        <ImageView fitHeight="27" fitWidth="27" preserveRatio="true">
                            <image>
                                <Image url="@../files/ventas.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                </Button>
                <Button onAction="#handleClientes" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10; -fx-text-fill: White;" text="Clientes" contentDisplay="LEFT" graphicTextGap="15">
                    <graphic>
                        <ImageView fitHeight="27" fitWidth="27" preserveRatio="true">
                            <image>
                                <Image url="@../files/clientes.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="logoutButton" onAction="#cerrarSesion" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10; -fx-text-fill: White;" text="Cerrar sesión" contentDisplay="LEFT" graphicTextGap="15">
                    <graphic>
                        <ImageView fitHeight="27" fitWidth="27" preserveRatio="true">
                            <image>
                                <Image url="@../files/logout.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>
        </left>
        <!-- Contenedor central -->
        <center>
            <StackPane fx:id="mainContent" style="-fx-background-color: #f4f4f7;">
                    <VBox spacing="10" alignment="CENTER" >
                        <Label text="Total de ventas realizadas"/>
                        <HBox spacing="10" alignment="CENTER">
                            <VBox>
                                <Label text="Fecha Inicio:" />
                                <DatePicker fx:id="datePickerInicio" />
                            </VBox>
                            <VBox>
                                <Label text="Fecha Fin:" />
                                <DatePicker fx:id="datePickerFin" />
                            </VBox>
                        </HBox>
                        <Button text="Calcular reporte" onAction="#calcularReporteVentas" />
                    </VBox>
                    <VBox fx:id="vbox" alignment="CENTER" spacing="20.0" styleClass="vbox" HBox.hgrow="ALWAYS" >
                        <Label text="Historial de ventas" textAlignment="CENTER" alignment="CENTER" textFill="WHITE">
                            <padding>
                                <Insets bottom="10.0" />
                            </padding>
                            <font>
                                <Font name="System Bold Italic" size="15.0" />
                            </font>
                        </Label>
                        <!-- Tabla que visualiza los usuarios -->
                        <TableView fx:id="tableView" minWidth="200.0" maxWidth="400">
                            <columns>
                                <TableColumn fx:id="fechaventaCol" prefWidth="90.0" text="Fecha venta" />
                                <TableColumn fx:id="totalventaCol" prefWidth="100.0" text="Total venta" />
                                <TableColumn fx:id="dniusuarioCol" prefWidth="100.0" text="Dni usuario" />
                                <TableColumn fx:id="dniclienteCol" prefWidth="100" text="Dni cliente" />
                            </columns>
                        </TableView> 
                        <padding>
                            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                        </padding>
                    </VBox>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>