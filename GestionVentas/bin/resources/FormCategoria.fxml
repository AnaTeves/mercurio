<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>        
<?import javafx.scene.image.ImageView?>

<!-- Vista del formulario para agregar una categoria -->
<StackPane fx:id="mainContentForm" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Controllers.FormCategoriaController">
    <VBox alignment="CENTER" style="-fx-background-color: #f4f4f7;" HBox.hgrow="ALWAYS">
        <VBox alignment="CENTER" maxHeight="800.0" maxWidth="450.0" minWidth="400.0" spacing="10.0" styleClass="vbox-externo">
            <padding>
                <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
            </padding>
            <!-- Icono de la categoría -->
            <ImageView fitHeight="80" fitWidth="80" preserveRatio="true">
                <image>
                    <Image url="@files/categorias.png" />
                </image>
                <VBox.margin>
                    <Insets top="25.0" />
                </VBox.margin>
            </ImageView>
            <!-- Título del formulario -->
            <Label styleClass="texto-comun" text="Formulario de registro" textAlignment="CENTER" textFill="BLACK">
                <padding>
                    <Insets bottom="10.0" />
                </padding>
            </Label>
            <!-- Campos del formulario -->
            <VBox alignment="CENTER_LEFT" maxHeight="315.0" maxWidth="250.0" prefHeight="315.0" prefWidth="250.0" spacing="10.0" styleClass="vbox-interno formulario-container">
                <Label styleClass="labels" text="Nombre" />
                <TextField fx:id="nombreField" styleClass="text-field-registro" alignment="TOP_LEFT" prefWidth="100.0" prefHeight="30.0" maxWidth="200.0" minWidth="100.0" promptText="Nombre" />
                <Label styleClass="labels" text="Descripcion" />
                <TextField fx:id="descripcionField" styleClass="text-field-registro" alignment="TOP_LEFT" prefWidth="100.0" prefHeight="30.0" maxWidth="200.0" minWidth="100.0" promptText="Descripcion" />
                <padding>
                    <Insets bottom="5.0" left="25.0" right="25.0" />
                </padding>
            </VBox>
            <!-- Contenedor horizontal para botones -->
            <HBox alignment="CENTER" styleClass="hbox">
                <Button styleClass="boton-registro" onAction="#agregarCategoria" prefHeight="25.0" prefWidth="111.0" text="Registrar" />
                <Button styleClass="boton-registro" onAction="#cancelar" prefHeight="25.0" prefWidth="111.0" text="Volver" />
                <padding>
                    <Insets top="15.0" />
                </padding>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
