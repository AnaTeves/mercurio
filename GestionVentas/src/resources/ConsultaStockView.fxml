<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #f4f4f7; -fx-padding: 25;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Controllers.ConsultaStockController">
    <!-- Barra de Búsqueda -->
    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #555555;" text="Buscar Producto:" />
        <TextField fx:id="txtBuscar" promptText="Ingrese ID o Nombre del producto..." style="-fx-pref-width: 350; -fx-padding: 7;" HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Tabla de Productos -->
    <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="80.0" style="-fx-alignment: CENTER;" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre del Producto" />
            <TableColumn fx:id="colCategoria" prefWidth="150.0" text="Categoría" />
            <TableColumn fx:id="colPrecio" prefWidth="120.0" style="-fx-alignment: CENTER-RIGHT;" text="Precio ($)" />
            <TableColumn fx:id="colStock" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Stock Actual" />
            <!-- Nueva Columna de Estado -->
            <TableColumn fx:id="colEstado" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Estado" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>