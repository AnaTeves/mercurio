<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: #f4f4f7; -fx-padding: 20;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Controllers.DetalleVendedoresController">
    
    <!-- Encabezado y Botón Volver -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button onAction="#handleVolver" style="-fx-background-color: rgb(90, 108, 128); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="← Volver a Reportes" />
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Detalle de Rendimiento por Vendedor" />
    </HBox>

    <!-- Contenedor Principal (Tarjeta) -->
    <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
        
        <!-- Barra de Filtros -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Filtrar Período:" />
            <DatePicker fx:id="dpDesde" prefWidth="130.0" promptText="Desde" />
            <DatePicker fx:id="dpHasta" prefWidth="130.0" promptText="Hasta" />
            <Button onAction="#handleFiltrar" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-cursor: hand;" text="Filtrar" />
            <Button onAction="#handleLimpiarFiltros" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-cursor: hand;" text="Limpiar" />
        </HBox>

        <!-- Tabla de Rendimiento -->
        <TableView fx:id="tablaVendedores" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colVendedor" prefWidth="180.0" text="Vendedor" />
                <TableColumn fx:id="colDni" prefWidth="100.0" text="DNI" />
                <TableColumn fx:id="colCantidadVentas" prefWidth="120.0" text="Total Ventas" />
                <TableColumn fx:id="colTotalRecaudado" prefWidth="130.0" text="Monto Recaudado ($)" />
                <TableColumn fx:id="colTotalArqueos" prefWidth="110.0" text="Cierres Caja" />
                <TableColumn fx:id="colCierresDiferencia" prefWidth="140.0" text="Cierres c/ Diferencia" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>