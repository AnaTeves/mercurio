<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: #f4f4f7; -fx-padding: 20;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Controllers.AuditoriaController">
    
    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Auditoría del Sistema" />

    <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            
            <Button text="← Volver al inicio" 
                    onAction="#handleVolver" 
                    style="-fx-background-color: #5a6c80; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
        </HBox>
        <!-- Barra de Filtros -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Módulo:" />
            <ComboBox fx:id="cbModulo" prefWidth="130.0" />
            
            <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Fecha:" />
            <DatePicker fx:id="dpDesde" prefWidth="130.0" promptText="Desde" />
            <DatePicker fx:id="dpHasta" prefWidth="130.0" promptText="Hasta" />
            
            <Button onAction="#handleFiltrar" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-cursor: hand;" text="Filtrar" />
            <Button onAction="#handleLimpiar" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-cursor: hand;" text="Limpiar" />
        </HBox>

        <!-- Tabla de Registros -->
        <TableView fx:id="tablaAuditoria" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colFecha" prefWidth="140.0" text="Fecha y Hora" />
                <TableColumn fx:id="colUsuario" prefWidth="150.0" text="Usuario" />
                <TableColumn fx:id="colModulo" prefWidth="110.0" text="Módulo" />
                <TableColumn fx:id="colAccion" prefWidth="140.0" text="Acción" />
                <TableColumn fx:id="colDetalle" prefWidth="300.0" text="Detalle de la Operación" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>