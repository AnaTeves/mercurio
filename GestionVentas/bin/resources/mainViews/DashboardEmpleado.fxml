<!-- Vista del vendedor al iniciar sesion -->
<StackPane alignment="CENTER" maxHeight="800" maxWidth="1000" prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Controllers.EmpleadoController">
    <BorderPane fx:id="mainBorderPane" StackPane.alignment="CENTER">
        <!-- Contenedor izquierdo -->
        <left>
            <!-- Contenedor vertical que contiene el menu de opciones -->
            <VBox fx:id="menuLateral" alignment="CENTER_LEFT" spacing="40" prefWidth="180" style="-fx-background-color: rgb(90, 108, 128);">
            <padding>
                <Insets left="20" right="20" />
            </padding>
                <Button style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10; -fx-text-fill: White;" text="Vendedor" contentDisplay="LEFT" graphicTextGap="15">
                    <graphic>
                        <ImageView fitHeight="27" fitWidth="27" preserveRatio="true">
                            <image>
                                <Image url="@../files/usuario.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                </Button>
                <Button onAction="#handleReports" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10; -fx-text-fill: White;" text="Reportes" contentDisplay="LEFT" graphicTextGap="15">
                    <graphic>
                        <ImageView fitHeight="27" fitWidth="27" preserveRatio="true">
                            <image>
                                <Image url="@../files/reportes.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                </Button>
                <Button onAction="#handleVentas" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10; -fx-text-fill: White;" text="Registrar&#10;Venta" contentDisplay="LEFT" graphicTextGap="15">
                    <graphic>
                        <ImageView fitHeight="27" fitWidth="27" preserveRatio="true">
                            <image>
                                <Image url="@../files/ventas.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                </Button>
                <Button onAction="#handleClientes" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10; -fx-text-fill: White;" text="Clientes" contentDisplay="LEFT" graphicTextGap="15">
                    <graphic>
                        <ImageView fitHeight="27" fitWidth="27" preserveRatio="true">
                            <image>
                                <Image url="@../files/clientes.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                </Button>
                <Button onAction="#handleConsultaStock" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10; -fx-text-fill: White;" text="Consulta&#10;Stock" contentDisplay="LEFT" graphicTextGap="15">
                    <graphic>
                        <ImageView fitHeight="27" fitWidth="27" preserveRatio="true">
                            <image>
                                <Image url="@../files/inventario.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="logoutButton" onAction="#cerrarSesion" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0 10; -fx-text-fill: White;" text="Cerrar turno" contentDisplay="LEFT" graphicTextGap="15">
                    <graphic>
                        <ImageView fitHeight="27" fitWidth="27" preserveRatio="true">
                            <image>
                                <Image url="@../files/logout.png" />
                            </image>
                            <effect>
                                <ColorAdjust brightness="1.0" />
                            </effect>
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>
        </left>
        <!-- Contenedor central -->
        <center>
            <StackPane fx:id="mainContent" style="-fx-background-color: #f4f4f7;">
                    <VBox fx:id="vbox" alignment="CENTER" spacing="20.0" styleClass="vbox" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                        </padding>
                        
                        <Label text="Mis Ventas del Día" textAlignment="CENTER" alignment="CENTER" textFill="BLACK" styleClass="titulo">
                            <padding>
                                <Insets bottom="15.0" />
                            </padding>
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        
                        <!-- Resumen de ventas del día -->
                        <HBox spacing="30" alignment="CENTER">
                            <VBox spacing="5" alignment="CENTER">
                                <Label styleClass="labels" text="Total Ventas:" />
                                <Label fx:id="lblTotalVentasDia" text="0" styleClass="texto-ingresos" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox spacing="5" alignment="CENTER">
                                <Label styleClass="labels" text="Monto Total:" />
                                <Label fx:id="lblMontoTotalDia" text="S/ 0.00" styleClass="texto-ingresos" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>
                        
                        <!-- Tabla de ventas del día del vendedor -->
                        <TableView fx:id="tableViewVentasDia" minWidth="600.0" prefHeight="300.0">
                            <columns>
                                <TableColumn fx:id="fechaventaCol" prefWidth="150.0" text="Fecha venta" />
                                <TableColumn fx:id="totalventaCol" prefWidth="120.0" text="Total venta" />
                                <TableColumn fx:id="dniclienteCol" prefWidth="150.0" text="Dni cliente" />
                                <TableColumn fx:id="detalleCol" prefWidth="100.0" text="Acción" />
                            </columns>
                        </TableView> 
                    </VBox>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
