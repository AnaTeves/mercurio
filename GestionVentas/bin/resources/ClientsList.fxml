<!-- Ventana que permite seleccionar un cliente existente o crear uno nuevo -->
<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Controllers.ClientsListController">
    <Label text="Seleccione un cliente:" />
    <TableView fx:id="tablaClientes">
        <columns>
            <TableColumn text="ID" fx:id="colId" />
            <TableColumn text="Nombre" fx:id="colNombre" />
            <TableColumn text="DNI" fx:id="colDni" />
        </columns>
    </TableView>
    <HBox spacing="10">
        <Button text="Seleccionar" onAction="#seleccionarCliente" />
        <Button text="Nuevo Cliente" onAction="#abrirFormularioCliente" />
    </HBox>
</VBox>
