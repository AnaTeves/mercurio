<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane alignment="CENTER" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Controllers.ClientsListController">
    <VBox alignment="CENTER" prefHeight="480.0" prefWidth="550.0" style="-fx-background-color: #f4f4f7;">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>

        <!-- Tarjeta del Selector -->
        <VBox alignment="CENTER" spacing="12.0" styleClass="vbox-externo">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>

            <ImageView fitHeight="45.0" fitWidth="45.0" preserveRatio="true">
                <image>
                    <Image url="@files/clientes.png" />
                </image>
            </ImageView>

            <Label styleClass="texto-comun" text="Seleccionar Cliente" textAlignment="CENTER" textFill="BLACK" />

            <TableView fx:id="tablaClientes" prefHeight="260.0" prefWidth="460.0">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="230.0" text="Nombre y Apellido" />
                    <TableColumn fx:id="colDni" prefWidth="150.0" text="DNI" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER" spacing="15.0" styleClass="hbox">
                <children>
                    <Button onAction="#seleccionarCliente" prefHeight="28.0" prefWidth="130.0" styleClass="boton-registro" text="Seleccionar" />
                    <Button onAction="#abrirFormularioCliente" prefHeight="28.0" prefWidth="130.0" styleClass="boton-registro" text="+ Nuevo Cliente" />
                </children>
                <padding>
                    <Insets top="10.0" />
                </padding>
            </HBox>
        </VBox>
    </VBox>
</StackPane>