<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<!-- Vista gestion categorías - Agregar, ver, buscar -->

<StackPane fx:id="mainContent" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Controllers.CategoriaController">
    <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f4f4f7;">
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
        </padding>

        <VBox alignment="CENTER_LEFT" maxWidth="850.0">
            <Label styleClass="titulo" text="Administración de categorías" textFill="BLACK" style="-fx-font-size: 24px;" />
            <Line endX="850.0" stroke="BLACK" strokeWidth="1.0" />
        </VBox>

        <VBox fx:id="finderContainer" 
              styleClass="finderContainer" 
              maxWidth="850.0" 
              spacing="25.0" 
              VBox.vgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>

            <HBox alignment="CENTER" spacing="100.0">
                <VBox spacing="10.0" HBox.hgrow="ALWAYS"> 
                    <Label styleClass="labels" text="Nombre" textFill="BLACK" />
                    <HBox spacing="5">
                        <TextField fx:id="buscarCategoria" promptText="Ingrese el nombre" HBox.hgrow="ALWAYS" prefHeight="35.0" />
                        <Button onAction="#recarga" style="-fx-background-color: #9fdfe2; -fx-cursor: hand;">
                            <graphic>
                                <ImageView fitHeight="17" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@files/recarga.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
                
                <VBox alignment="BOTTOM_CENTER">
                    <Button fx:id="btnAñadir" onAction="#añadirCategoria" 
                            style="-fx-background-color: rgb(90, 108, 128); -fx-text-fill: White; -fx-font-weight: bold; -fx-cursor: hand;" 
                            text="+ Añadir categoría" prefHeight="35.0" />
                </VBox>
            </HBox>

            <TableView fx:id="tableView" VBox.vgrow="ALWAYS" maxWidth="Infinity" prefHeight="400.0">
                <columns>
                    <TableColumn fx:id="idCol" prefWidth="80.0" text="ID" />
                    <TableColumn fx:id="nombreCol" prefWidth="250.0" text="Nombre" />
                    <TableColumn fx:id="descCol" prefWidth="400.0" text="Descripción" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</StackPane>