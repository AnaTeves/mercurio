<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<!-- Vista del inicio de sesion -->
<StackPane prefHeight="450.0" prefWidth="400.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Controllers.LoginController">
    <VBox fx:id="logoLabelContainer" alignment="CENTER" spacing="20.0" styleClass="vbox" StackPane.alignment="CENTER">
        <!-- Imagen -->
        <ImageView fx:id="logoView" fitHeight="116.0" fitWidth="339.0" styleClass="image-view">
            <image>
                <Image url="@files/logonegro.png" />
            </image>
        </ImageView>
        <!-- Campo documento -->
        <Label text="Documento" textFill="BLACK"/>
        <TextField fx:id="dniField" maxWidth="200.0" prefHeight="35.0" promptText="Ingrese su DNI" />
        <!-- Campo contraseña -->
        <Label text="Contraseña" textFill="BLACK"/>
        <PasswordField fx:id="passwordField" maxWidth="200.0" prefHeight="35.0" promptText="Contraseña" />
        <!-- Contenedor horizontal para botones -->
        <HBox alignment="CENTER" spacing="10" styleClass="hbox">
            <!-- Botones -->
            <Button fx:id="btnLogin" onAction="#handleLogin" prefHeight="30.0" prefWidth="70.0" text="Ingresar" textAlignment="CENTER" style="-fx-background-color: #b6dfaa;"/>
            <Button fx:id="btnOut" onAction="#handleCancel" prefHeight="30.0" prefWidth="70.0" text="Cerrar" textAlignment="CENTER" style="-fx-background-color: #fbb09d;"/>
        </HBox>
    </VBox>
</StackPane>