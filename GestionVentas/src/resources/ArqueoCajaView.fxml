<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>

<StackPane fx:id="mainContent" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Controllers.ArqueoCajaController">
    <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #f4f4f7;">
        <padding>
            <Insets bottom="30.0" left="20.0" right="20.0" top="30.0" />
        </padding>

        <VBox alignment="CENTER_LEFT" maxWidth="1000.0">
            <Label text="Arqueo y Auditoría de Cajas" styleClass="titulo" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
            <Line endX="1000.0" stroke="BLACK" strokeWidth="1.0" />
        </VBox>

        <VBox maxWidth="1000.0" spacing="15.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">
            <HBox alignment="CENTER_RIGHT">
                <Button text="🔄 Actualizar Tabla" onAction="#cargarTabla" style="-fx-background-color: #5a6c80; -fx-text-fill: white; -fx-cursor: hand;" />
            </HBox>

            <TableView fx:id="tablaArqueo" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="40.0" text="N°" />
                    <TableColumn fx:id="colVendedor" prefWidth="150.0" text="Vendedor" />
                    <TableColumn fx:id="colDni" prefWidth="90.0" text="DNI" />
                    <TableColumn fx:id="colApertura" prefWidth="120.0" text="F. Apertura" />
                    <TableColumn fx:id="colCierre" prefWidth="120.0" text="F. Cierre" />
                    <TableColumn fx:id="colInicial" prefWidth="90.0" text="M. Inicial" />
                    <TableColumn fx:id="colSistema" prefWidth="90.0" text="Esperado" />
                    <TableColumn fx:id="colReal" prefWidth="90.0" text="Declarado" />
                    <TableColumn fx:id="colDiferencia" prefWidth="90.0" text="Diferencia" />
                    <TableColumn fx:id="colEstado" prefWidth="80.0" text="Estado" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</StackPane>