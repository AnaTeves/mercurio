<!-- Vista para registrar una nueva venta -->
<StackPane xmlns="http://javafx.com/javafx/22" stylesheets="@styles.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Controllers.VentaController">
        <VBox alignment="CENTER" spacing="20.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #f4f4f7;">
            <!-- Container for the tittle -->
            <VBox alignment="CENTER_LEFT" maxWidth="600.0">
                <Label text="Registro de venta" textAlignment="CENTER" textFill="BLACK" styleClass="titulo"></Label>
                <Line startX="0.0" startY="0.0" endX="600.0" endY="0.0" stroke="BLACK" strokeWidth="1.0"/>
            </VBox>
            <!-- Container -->
            <HBox alignment="CENTER" spacing="100" styleClass="finderContainer" maxWidth="600.0">
                <!-- Contenedor cliente -->
                <VBox spacing="10">
                    <Label text="Cliente:"/>
                    <HBox>
                        <TextField fx:id="campoCliente" promptText="Presione el boton..." />
                        <Button text="Buscar🔍" onAction="#openTheWindowClients"/>
                    </HBox>
                </VBox>
                <!-- Contenedor vendedor -->
                <VBox spacing="10">
                    <Label text="Vendedor:"/>
                    <HBox spacing="10">
                        <Label fx:id="nameLabel" style="-fx-font-weight: bold;"/>
                        <Label fx:id="dniLabel" style="-fx-font-size: 14px;"/>
                    </HBox>
                </VBox>
            </HBox>
            <HBox>
                <TextField fx:id="buscarProducto" promptText="Buscar producto..."/>
                <Button onAction="#buscarProducto" text="Buscar 🔍"/>
            </HBox>
            <TableView fx:id="tablaDetalleVenta">
                <columns>
                    <TableColumn fx:id="colIDProducto" text="ID" />    
                    <TableColumn fx:id="colProducto" text="Producto" />
                    <TableColumn fx:id="colCantidad" text="Cantidad" />
                    <TableColumn fx:id="colSubtotal" text="Subtotal" />
                    <TableColumn fx:id="colAcciones" text="Acciones" />
                </columns>
            </TableView>
        </VBox>
</StackPane>